@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<nav class="flex-column bg-light p-3" style="width:250px; min-height:100vh;">
    <h5 class="mb-3">Menu</h5>

    <ul class="nav nav-pills flex-column mb-auto">

        <!-- Home -->
        <li class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
        </li>

        <!-- SalesAndReturn 섹션 -->
        <li>
            <button class="nav-link dropdown-toggle btn btn-toggle align-items-center"
                    data-bs-toggle="collapse" data-bs-target="#salesMenu"
                    aria-expanded="false">
                SalesAndReturn
            </button>
            <div class="collapse" id="salesMenu">
                <ul class="list-unstyled ps-3">
                    <li><NavLink class="nav-link" href="/SalesReturn/Shopping">Shopping</NavLink></li>
                    <li><NavLink class="nav-link" href="/SalesReturn/Cart">Cart</NavLink></li>
                    <li><NavLink class="nav-link" href="/SalesReturn/Checkout">Checkout</NavLink></li>
                    <li><NavLink class="nav-link" href="/SalesReturn/Refund">Refund</NavLink></li>
                </ul>
            </div>
        </li>

        <!-- PurchaseOrder 섹션 -->
        <li>
            <button class="nav-link dropdown-toggle btn btn-toggle align-items-center"
                    data-bs-toggle="collapse" data-bs-target="#purchaseMenu"
                    aria-expanded="false">
                PurchaseOrder
            </button>
            <div class="collapse" id="purchaseMenu">
                <ul class="list-unstyled ps-3">
                    <li><NavLink class="nav-link" href="/PurchaseOrders/Vendors">Order Stock</NavLink></li>
                </ul>
            </div>
        </li>

        <!-- Other pages -->
        <li><NavLink class="nav-link" href="counter">Counter</NavLink></li>
        <li><NavLink class="nav-link" href="weather">Weather</NavLink></li>
        <li><NavLink class="nav-link" href="auth">Auth Required</NavLink></li>

        <!-- Authentication -->
        <AuthorizeView>
            <Authorized>
                <li><NavLink class="nav-link" href="Account/Manage">@context.User.Identity?.Name</NavLink></li>
                <li><a href="#" class="nav-link" @onclick="Logout">Logout</a></li>
            </Authorized>
            <NotAuthorized>
                <li><NavLink class="nav-link" href="Account/Register">Register</NavLink></li>
                <li><NavLink class="nav-link" href="Account/Login">Login</NavLink></li>
            </NotAuthorized>
        </AuthorizeView>

    </ul>
</nav>

@code {
    private void Logout()
    {
        NavigationManager.NavigateTo("Account/Logout", true);
    }
}
