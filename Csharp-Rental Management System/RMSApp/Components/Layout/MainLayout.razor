@inherits LayoutComponentBase

<div class="d-flex" style="min-height: 100vh;">
    <!-- Sidebar -->
    <nav class="bg-dark text-white p-3 flex-shrink-0" style="width: 220px;">
        <NavMenu />
    </nav>

    <!-- Main Content -->
    <div class="flex-grow-1">
        <header class="bg-light border-bottom p-2 d-flex justify-content-end">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" class="btn btn-sm btn-outline-primary">
                About
            </a>
        </header>

        <main class="p-3">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
